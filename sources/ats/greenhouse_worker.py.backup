from __future__ import annotations

import argparse
import hashlib
import json
import logging
import re
import sys
import time
from datetime import date, datetime
from typing import Any

from ats_scrapers import get_scraper_for_url


# ============================================================
# CONFIGURATION
# ============================================================

DEFAULT_RETRIES = 3
DEFAULT_TIMEOUT = 30

FRESHER_PATTERNS = [
    r"\bfresher\b",
    r"\bfreshers\b",
    r"\bentry[\s-]?level\b",
    r"\bgraduate\b",
    r"\brecent graduate\b",
    r"\bnew graduate\b",
    r"\btrainee\b",
    r"\bjunior\b",
    r"\bassociate\b",
    r"\bapprentice\b",
    r"\bintern\b",
    r"\binternship\b",
    r"\bno experience\b",
    r"\bno prior experience\b",
    r"\bexperience not required\b",
    r"\b0\s*[-–]?\s*1\s*(?:year|years|yr|yrs)\b",
    r"\b0\s*[-–]?\s*2\s*(?:year|years|yr|yrs)\b",
]

INDIA_PATTERNS = [
    r"\bindia\b",
    r"\bhyderabad\b",
    r"\bbengaluru\b",
    r"\bbangalore\b",
    r"\bchennai\b",
    r"\bpune\b",
    r"\bmumbai\b",
    r"\bdelhi\b",
    r"\bgurgaon\b",
    r"\bgurugram\b",
    r"\bnoida\b",
    r"\bkolkata\b",
    r"\bahmedabad\b",
    r"\bkochi\b",
    r"\btrivandrum\b",
]

REMOTE_PATTERNS = [
    r"\bremote\b",
    r"\bwork from home\b",
    r"\bwfh\b",
    r"\banywhere\b",
]


# ============================================================
# LOGGING
# ============================================================

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s | %(levelname)s | %(message)s",
    stream=sys.stderr,
)

logger = logging.getLogger("ats-worker")


# ============================================================
# HELPERS
# ============================================================

def clean_text(value: Any) -> str | None:
    """Convert a value to clean text."""
    if value is None:
        return None

    if isinstance(value, str):
        value = re.sub(r"\s+", " ", value).strip()
        return value or None

    return str(value).strip() or None


def serialize(value: Any) -> Any:
    """Make arbitrary Python/Pydantic data JSON serializable."""
    if value is None:
        return None

    if isinstance(value, (str, int, float, bool)):
        return value

    if isinstance(value, (datetime, date)):
        return value.isoformat()

    if isinstance(value, dict):
        return {
            str(k): serialize(v)
            for k, v in value.items()
        }

    if isinstance(value, (list, tuple, set)):
        return [serialize(v) for v in value]

    if hasattr(value, "model_dump"):
        return serialize(value.model_dump())

    return str(value)


def normalize_for_matching(value: Any) -> str:
    """Normalize text for matching/fingerprinting."""
    text = clean_text(value) or ""
    text = text.lower()
    text = re.sub(r"[^a-z0-9]+", " ", text)
    return re.sub(r"\s+", " ", text).strip()


def contains_pattern(text: str, patterns: list[str]) -> bool:
    """Check whether text matches any regex pattern."""
    text = text.lower()

    return any(
        re.search(pattern, text, flags=re.IGNORECASE)
        for pattern in patterns
    )


def detect_fresher(job: dict[str, Any]) -> bool:
    """Detect likely fresher/entry-level jobs."""
    experience = clean_text(job.get("experience"))
    title = clean_text(job.get("title"))
    description = clean_text(job.get("description"))

    combined = " ".join(
        value or ""
        for value in [title, experience, description]
    )

    return contains_pattern(combined, FRESHER_PATTERNS)


def detect_india(job: dict[str, Any]) -> bool:
    """Detect India-related location information."""
    location = clean_text(job.get("location"))
    country = clean_text(job.get("country"))

    combined = " ".join(
        value or ""
        for value in [location, country]
    )

    return contains_pattern(combined, INDIA_PATTERNS)


def detect_remote(job: dict[str, Any]) -> bool:
    """Detect remote work."""
    if job.get("is_remote") is True:
        return True

    work_mode = clean_text(job.get("work_mode"))

    if work_mode and contains_pattern(work_mode, REMOTE_PATTERNS):
        return True

    location = clean_text(job.get("location"))

    if location and contains_pattern(location, REMOTE_PATTERNS):
        return True

    return False


def generate_fingerprint(job: dict[str, Any]) -> str:
    """
    Generate a stable fingerprint for deduplication.

    Prefer ATS/global identifiers when available.
    Otherwise use company + title + location + requisition.
    """
    global_id = clean_text(job.get("global_id"))

    if global_id:
        source = global_id

    else:
        source = "|".join(
            [
                normalize_for_matching(job.get("company")),
                normalize_for_matching(job.get("title")),
                normalize_for_matching(job.get("location")),
                normalize_for_matching(job.get("requisition_id")),
            ]
        )

    return hashlib.sha256(
        source.encode("utf-8")
    ).hexdigest()


def calculate_confidence(job: dict[str, Any]) -> int:
    """
    Calculate basic ingestion confidence.

    This is NOT the final candidate match score.
    AI scoring will be added later.
    """
    score = 50

    if job.get("global_id"):
        score += 15

    if job.get("source_url"):
        score += 10

    if job.get("company"):
        score += 5

    if job.get("title"):
        score += 5

    if job.get("location"):
        score += 5

    if job.get("posted_at"):
        score += 5

    if job.get("application_url"):
        score += 5

    return min(score, 100)


# ============================================================
# NORMALIZATION
# ============================================================

def normalize_job(job: Any) -> dict[str, Any]:
    """Convert ATS Job object into our normalized schema."""
    data = serialize(job)

    description = clean_text(data.get("description"))
    experience = clean_text(data.get("experience"))

    normalized = {
        # Identity
        "global_id": clean_text(data.get("global_id")),
        "fingerprint": None,

        # Source
        "source": clean_text(data.get("ats_type")),
        "source_url": clean_text(data.get("url")),
        "application_url": clean_text(data.get("apply_url")),

        # Employer
        "company": clean_text(data.get("company")),
        "employer_type": "company",
        "agency_name": None,

        # Job
        "title": clean_text(data.get("title")),
        "description": description,

        # Location
        "location": clean_text(data.get("location")),
        "country": clean_text(data.get("country_iso")),
        "region": clean_text(data.get("region")),

        # Work mode
        "is_remote": data.get("is_remote"),
        "work_mode": "Unknown",

        # Experience
        "experience": experience,
        "is_fresher_friendly": False,

        # Salary
        "salary_currency": clean_text(data.get("salary_currency")),
        "salary_period": clean_text(data.get("salary_period")),
        "salary_summary": clean_text(data.get("salary_summary")),
        "salary_min": data.get("salary_min"),
        "salary_max": data.get("salary_max"),

        # Organization
        "department": clean_text(data.get("department")),
        "team": clean_text(data.get("team")),

        # IDs
        "requisition_id": clean_text(data.get("requisition_id")),
        "ats_id": clean_text(data.get("ats_id")),

        # Dates
        "posted_at": serialize(data.get("posted_at")),
        "deadline": serialize(data.get("application_deadline")),
        "fetched_at": serialize(data.get("fetched_at")),

        # Language
        "language": clean_text(data.get("language")),

        # Pipeline metadata
        "country_match": False,
        "job_confidence": 0,

        # Original source data
        "raw": serialize(data.get("raw")),
    }

    # Determine work mode
    if normalized["is_remote"] is True:
        normalized["work_mode"] = "Remote"
    elif normalized["location"]:
        normalized["work_mode"] = "On-site/Hybrid"
    else:
        normalized["work_mode"] = "Unknown"

    # Fresher detection
    normalized["is_fresher_friendly"] = detect_fresher(
        {
            "title": normalized["title"],
            "description": normalized["description"],
            "experience": normalized["experience"],
        }
    )

    # India detection
    normalized["country_match"] = detect_india(
        {
            "location": normalized["location"],
            "country": normalized["country"],
        }
    )

    # Remote detection
    if detect_remote(
        {
            "is_remote": normalized["is_remote"],
            "work_mode": normalized["work_mode"],
            "location": normalized["location"],
        }
    ):
        normalized["work_mode"] = "Remote"

    # Fingerprint
    normalized["fingerprint"] = generate_fingerprint(
        normalized
    )

    # Confidence
    normalized["job_confidence"] = calculate_confidence(
        normalized
    )

    return normalized


# ============================================================
# SCRAPER
# ============================================================

def fetch_jobs(
    careers_url: str,
    retries: int = DEFAULT_RETRIES,
) -> list[Any]:
    """Fetch jobs with simple retry handling."""
    last_error: Exception | None = None

    for attempt in range(1, retries + 1):
        try:
            logger.info(
                "Creating ATS scraper for: %s",
                careers_url,
            )

            scraper = get_scraper_for_url(
                careers_url,
                timeout=DEFAULT_TIMEOUT,
            )

            logger.info(
                "Detected ATS: %s",
                getattr(scraper, "ats", "unknown"),
            )

            logger.info(
                "Fetching jobs... attempt %d/%d",
                attempt,
                retries,
            )

            jobs = scraper.fetch()

            logger.info(
                "Fetched %d jobs",
                len(jobs),
            )

            return jobs

        except Exception as exc:
            last_error = exc

            logger.warning(
                "Fetch failed on attempt %d/%d: %s",
                attempt,
                retries,
                exc,
            )

            if attempt < retries:
                time.sleep(attempt * 2)

    raise RuntimeError(
        f"Failed to fetch jobs after {retries} attempts: "
        f"{last_error}"
    )


# ============================================================
# CLI
# ============================================================

def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Job Intelligence Agent - ATS Worker"
    )

    parser.add_argument(
        "careers_url",
        help="Public ATS careers URL",
    )

    parser.add_argument(
        "--limit",
        type=int,
        default=None,
        help="Maximum number of jobs to output",
    )

    parser.add_argument(
        "--fresher-only",
        action="store_true",
        help="Output only likely fresher/entry-level jobs",
    )

    parser.add_argument(
        "--india-only",
        action="store_true",
        help="Output only India-related jobs",
    )

    parser.add_argument(
        "--remote-only",
        action="store_true",
        help="Output only remote jobs",
    )

    parser.add_argument(
        "--pretty",
        action="store_true",
        help="Pretty-print JSON",
    )

    return parser.parse_args()


# ============================================================
# MAIN
# ============================================================

def main() -> None:
    args = parse_args()

    try:
        jobs = fetch_jobs(args.careers_url)

        normalized_jobs = [
            normalize_job(job)
            for job in jobs
        ]

        # Filters
        if args.fresher_only:
            normalized_jobs = [
                job
                for job in normalized_jobs
                if job["is_fresher_friendly"]
            ]

        if args.india_only:
            normalized_jobs = [
                job
                for job in normalized_jobs
                if job["country_match"]
            ]

        if args.remote_only:
            normalized_jobs = [
                job
                for job in normalized_jobs
                if job["work_mode"] == "Remote"
            ]

        # Limit AFTER filtering
        if args.limit is not None:
            normalized_jobs = normalized_jobs[:args.limit]

        output = {
            "success": True,
            "source_url": args.careers_url,
            "fetched_count": len(jobs),
            "returned_count": len(normalized_jobs),
            "fetched_at": datetime.now().astimezone().isoformat(),
            "jobs": normalized_jobs,
        }

        if args.pretty:
            print(
                json.dumps(
                    output,
                    indent=2,
                    ensure_ascii=False,
                    default=serialize,
                )
            )
        else:
            print(
                json.dumps(
                    output,
                    ensure_ascii=False,
                    default=serialize,
                )
            )

    except KeyboardInterrupt:
        logger.warning("Interrupted by user")
        sys.exit(130)

    except Exception as exc:
        error_output = {
            "success": False,
            "source_url": args.careers_url,
            "error": str(exc),
            "error_type": type(exc).__name__,
        }

        print(
            json.dumps(
                error_output,
                indent=2,
                ensure_ascii=False,
            )
        )

        sys.exit(1)


if __name__ == "__main__":
    main()